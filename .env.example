# HTTP server
PORT=3000
API_BASE_URL=http://localhost:3000
WALLET_ADDRESS=

# testnet (local demo) or mainnet (Challenge deployment)
ALGORAND_NETWORK=testnet

# Public address that receives USDC. The server never needs its private key.
PAY_TO_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz
PRICE_USDC=$0.001

# Public account-data source. Defaults to AlgoNode when omitted.
# INDEXER_URL=https://testnet-idx.algonode.cloud

# Disposable demo/test wallet only. Never use a production mnemonic.
CLIENT_MNEMONIC=

# Enables the local one-click TestNet agent. It is always rejected on MainNet.
DEMO_MODE=false

# Enable only for a public MainNet Global x402 Challenge deployment.
CHALLENGE_MODE=false

# direct uses a known URL; bazaar performs real facilitator catalog discovery.
AGENT_DISCOVERY=direct
