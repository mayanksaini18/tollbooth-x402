# HTTP server
PORT=3100
API_BASE_URL=http://localhost:3100

# testnet (local demo) or mainnet (Challenge deployment)
ALGORAND_NETWORK=testnet

# Both wallets are created for you by `pnpm wallet`, which also opts them into USDC
# and tells you what still needs funding. Disposable TestNet wallets only.
CLIENT_MNEMONIC=
PUBLISHER_MNEMONIC=

# Public address that receives USDC. `pnpm wallet` fills this from PUBLISHER_MNEMONIC.
PAY_TO_ADDRESS=
WALLET_ADDRESS=

FACILITATOR_URL=https://facilitator.goplausible.xyz
PRICE_USDC=$0.001

# What the research agent may spend answering one question. Deliberately smaller
# than the shortlist is worth, so the agent has to rank rather than just filter.
AGENT_BUDGET_USD=0.01

# Appraisal + synthesis. Free tier: https://aistudio.google.com/apikey
# Without a key the demo still runs on keyword ranking.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_API_KEY=

# Public account-data source. Defaults to AlgoNode when omitted.
# INDEXER_URL=https://testnet-idx.algonode.cloud

DEMO_MODE=false
CHALLENGE_MODE=false
AGENT_DISCOVERY=direct
